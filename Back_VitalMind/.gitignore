# Dependencias
node_modules/

# Variables de entorno
.env
.env.*

# Logs
logs/
*.log

# Archivos temporales
tmp/
temp/

# Cobertura de pruebas
coverage/

# Build
dist/

# Archivos del sistema
.vscode/
.DS_Store
Thumbs.db

# Copia este archivo como ".env" en la misma carpeta (Back_VitalMind) antes de arrancar el backend.
# Estos son los valores por defecto que ya usa el proyecto si no pones .env,
# y coinciden con el docker-compose.yml incluido, así que normalmente NO necesitas cambiar nada.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=vitalmind
MYSQL_CONNECT_TIMEOUT_MS=5000

# Necesaria para que el Chatbot IA (VitalMind Chat) funcione con respuestas reales.
# Consigue tu clave en https://console.gemini.com/ y pégala aquí (sin espacios).
GEMINI_API_KEY=[REDACTED]
vitalmind_produccion.sql